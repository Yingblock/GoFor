{
  "name": "gofor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @gofor/web build",
    "check": "biome check --write .",
    "check:boundaries": "node tools/check-plugin-boundaries.mjs && node tools/check-core-data-boundaries.mjs",
    "dev": "pnpm --filter @gofor/web dev",
    "e2e": "node e2e/smoke.mjs",
    "e2e:external": "node e2e/external-smoke.mjs",
    "plugin:host": "node packages/plugin-host/dist/cli.js",
    "plugins:build": "node tools/build-external-plugins.mjs",
    "plugins:install": "node tools/install-external-plugins.mjs",
    "preview": "pnpm --filter @gofor/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@gofor/plugin-cli": "workspace:*",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
