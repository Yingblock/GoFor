{
  "name": "gofor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gofor/web dev",
    "build": "pnpm --filter @gofor/web build",
    "preview": "pnpm --filter @gofor/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "biome check --write .",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
